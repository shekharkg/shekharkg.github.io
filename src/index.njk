---
layout: base.njk
permalink: /
---
<section class="hero wrap" aria-labelledby="hero-title">
  <p class="prompt" aria-hidden="true"><span class="caret">&gt;</span> whoami</p>
  <h1 id="hero-title">{{ site.name }}</h1>
  <p class="hero-role">{{ site.role }}: Android, cross-platform mobile, web and games.</p>
  <p class="hero-pitch">
    I take products from idea to store: architecture, code, tests, design and release.
    I've been shipping Android apps since {{ site.since }}. {{ site.studio.line }}
    I share sample code on GitHub and contribute back to the open-source tools I build on.
  </p>
  <p class="actions">
    <a class="button" href="#work">See my work</a>
    <a class="text-link" href="mailto:{{ site.email }}">{{ site.email }}</a>
    {%- for l in site.links %}
    <a class="text-link" href="{{ l.url }}" rel="me">{{ l.label }} ↗</a>
    {%- endfor %}
  </p>
</section>

<section id="work" class="wrap section" aria-labelledby="work-title">
  <header class="section-head">
    <h2 id="work-title">Selected work</h2>
    <p class="muted">Products, games and client work from {{ site.studio.name }}. Source code is private, so each one has a case study instead.</p>
  </header>
  <div class="features">
    {%- for p in projects %}{% if p.featured %}
    {% include "card.njk" %}
    {%- endif %}{% endfor %}
  </div>
</section>

<section id="more" class="wrap section" aria-labelledby="more-title">
  <header class="section-head">
    <h2 id="more-title">More work and experiments</h2>
  </header>
  <ul class="grid">
    {%- for p in projects %}{% if not p.featured %}
    <li class="tile">
      <p class="eyebrow"><span class="tag">{{ p.kind }}</span> <span>{{ p.platform }}</span> <span aria-hidden="true">·</span> <span>{{ p.status }}</span></p>
      <h3>{{ p.title }}</h3>
      <p>{{ p.tagline }}</p>
      <ul class="ticks">
        {%- for h in p.highlights %}<li>{{ h }}</li>{% endfor %}
      </ul>
      <ul class="chips" aria-label="Stack">
        {%- for s in p.stack %}<li>{{ s }}</li>{% endfor %}
      </ul>
    </li>
    {%- endif %}{% endfor %}
  </ul>
</section>

<section id="open-source" class="wrap section" aria-labelledby="oss-title">
  <header class="section-head">
    <h2 id="oss-title">Open source</h2>
    <p class="muted">Contributions to other projects, and the public code I've written along the way.</p>
  </header>

  {%- if oss.contributions.length %}
  <h3 class="sub">Contributions</h3>
  <ul class="list">
    {%- for c in oss.contributions %}
    <li>
      <a href="{{ c.url }}">{{ c.title }}</a>
      <span class="muted"> · {{ c.repo }} · {{ c.merged }}</span>
    </li>
    {%- endfor %}
  </ul>
  {%- endif %}

  <h3 class="sub">Public repositories</h3>
  <ul class="grid compact">
    {%- for r in oss.repos %}
    <li class="tile">
      <h4><a href="{{ r.url }}">{{ r.name }}</a></h4>
      <p>{{ r.text }}</p>
      <p class="muted small">{{ r.language }} · {{ r.year }}</p>
    </li>
    {%- endfor %}
  </ul>
  <p><a class="text-link" href="https://github.com/shekharkg?tab=repositories">All repositories on GitHub ↗</a></p>
</section>

<section id="skills" class="wrap section" aria-labelledby="skills-title">
  <header class="section-head">
    <h2 id="skills-title">What I work with</h2>
  </header>
  <dl class="skills">
    {%- for g in site.skills %}
    <div>
      <dt>{{ g.group }}</dt>
      <dd>{{ g.items | join(" · ") }}</dd>
    </div>
    {%- endfor %}
  </dl>
</section>

<section id="contact" class="wrap section contact" aria-labelledby="contact-title">
  <h2 id="contact-title">Let's talk</h2>
  <p>Have a product to build, a team that needs an Android or mobile engineer, or an open-source project I could help with? Email is the best way to reach me.</p>
  <p class="actions">
    <a class="button" href="mailto:{{ site.email }}">{{ site.email }}</a>
    {%- for l in site.links %}
    <a class="text-link" href="{{ l.url }}" rel="me">{{ l.label }} ↗</a>
    {%- endfor %}
  </p>
  <p class="muted small">{{ site.location }}</p>
</section>
