{#- Featured project card. Expects `p`. -#}
<article class="feature{% if p.images.length %} has-media{% endif %} shape-{{ p.imageShape or 'none' }}">
  <div class="feature-body">
    <p class="eyebrow">
      <span class="tag">{{ p.kind }}</span>
      <span>{{ p.platform }}</span>
      <span aria-hidden="true">·</span>
      <span>{{ p.status }}</span>
    </p>
    <h3><a href="/projects/{{ p.slug }}/">{{ p.title }}</a></h3>
    <p class="lede">{{ p.tagline }}</p>
    {%- if p.metrics.length %}
    <dl class="metrics">
      {%- for m in p.metrics %}
      <div><dt>{{ m.label }}</dt><dd>{{ m.value }}</dd></div>
      {%- endfor %}
    </dl>
    {%- endif %}
    <ul class="chips" aria-label="Stack">
      {%- for s in p.stack %}<li>{{ s }}</li>{% endfor %}
    </ul>
    <p class="actions">
      <a class="button" href="/projects/{{ p.slug }}/">Read the case study<span class="sr"> about {{ p.title }}</span> →</a>
      {%- for l in p.links %}
      <a class="text-link" href="{{ l.url }}">{{ l.label }} ↗</a>
      {%- endfor %}
    </p>
  </div>
  {%- if p.images.length %}
  <figure class="feature-media">
    {%- if p.imageShape == "phone" %}
      {%- for img in p.images | batch(2) | first %}
      <img src="{{ img.src }}" alt="{{ img.alt }}" loading="lazy" decoding="async" width="480" height="853">
      {%- endfor %}
    {%- else %}
      <img src="{{ p.images[0].src }}" alt="{{ p.images[0].alt }}" loading="lazy" decoding="async" width="{{ p.images[0].w or 960 }}" height="{{ p.images[0].h or 977 }}">
    {%- endif %}
  </figure>
  {%- else %}
  <div class="feature-media placeholder" aria-hidden="true">
    <span>{{ p.kind }}<br>details anonymised</span>
  </div>
  {%- endif %}
</article>
